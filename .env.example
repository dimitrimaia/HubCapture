# Variáveis do Hub Capture. Cadastre na Vercel (Settings → Environment Variables), marque Production
# (Preview é opcional) e faça redeploy. Nada aqui tem valor real: o repositório é público.

# ── Planilhas (Google Apps Script) · docs/google-sheets-webhook.md ───────────────────────────────
# Planilha "Usuários Cadastrados HubCapture" (formulário /cadastro e aba de ações)
CADASTRO_WEBHOOK_URL=
# Planilha de afiliados/influencers (formulário "Colab com Influencers")
INFLUENCER_WEBHOOK_URL=
# Token que libera a leitura da aba Cadastro (doGet) para o botão "Importar planilha"
PLANILHA_LEITURA_TOKEN=
# Opcional: token da planilha de influencers (aba Colab). Sem ele, usa o PLANILHA_LEITURA_TOKEN
INFLUENCER_LEITURA_TOKEN=

# ── Banco de dados (Supabase, grátis) · docs/banco-de-dados.md ───────────────────────────────────
# URL do "Transaction pooler" (porta 6543). Senha com & ou + precisa ser codificada (%26, %2B).
DATABASE_URL=

# ── Painel da equipe (/equipe) · docs/painel.md ──────────────────────────────────────────────────
# Chave de instalação (8+ caracteres): cria o primeiro admin e assina os cookies de login.
# Cada pessoa entra com usuário e senha próprios. Trocar esta chave desloga todo mundo.
EQUIPE_SENHA=
# Opcional: segredo só para assinar os cookies (aí trocar EQUIPE_SENHA não desloga ninguém)
EQUIPE_SEGREDO=

# ── WhatsApp do atendimento (botões wa.me do site) ───────────────────────────────────────────────
# Só dígitos, com DDI e DDD. Ex.: 5511900000000. Fica visível no site (é público).
NEXT_PUBLIC_WHATSAPP_ATENDIMENTO=

# ── Assistente (Gemini, nível gratuito) · docs/assistente.md ─────────────────────────────────────
GEMINI_API_KEY=
# Opcional: fixa o modelo (sem ela, usa gemini-flash-latest e alternativas)
ASSISTENTE_MODELO=

# ── WhatsApp Cloud API (Meta) · docs/whatsapp.md ─────────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Texto que você inventa e repete no painel da Meta ao configurar o webhook
WHATSAPP_VERIFY_TOKEN=
# Campanhas (docs/campanhas.md): ID da conta do WhatsApp Business e limite diário de contatos (padrão 250)
WHATSAPP_WABA_ID=
WHATSAPP_LIMITE_DIARIO=
# Opcional (padrão v23.0)
WHATSAPP_API_VERSION=

# ── Lembretes automáticos no WhatsApp (pagos, DESLIGADOS) · docs/bots-whatsapp.md ────────────────
# "ligado" para ativar. Precisa dos modelos aprovados na Meta e de um cron externo chamando
# /api/cron/lembretes com o cabeçalho Authorization: Bearer CRON_SECRET.
LEMBRETES_WHATSAPP=
CRON_SECRET=
WHATSAPP_MODELO_LEMBRETE_1=
WHATSAPP_MODELO_LEMBRETE_2=
# Idioma dos modelos na Meta (padrão pt_BR)
WHATSAPP_MODELO_IDIOMA=

# ── Alerta de erro por e-mail (Resend, grátis) · docs/backup.md ──────────────────────────────────
RESEND_API_KEY=
# Quem recebe (use o mesmo e-mail da conta Resend)
ALERTA_EMAIL=
# Opcional: remetente com domínio verificado no Resend (padrão onboarding@resend.dev)
ALERTA_REMETENTE=

# Backup semanal: NÃO vai na Vercel. Cadastre BACKUP_DATABASE_URL e BACKUP_SENHA em
# GitHub → Settings → Secrets and variables → Actions (docs/backup.md).
